<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ================= MAIN THEME ================= -->
    <style name="Theme.MyPham" parent="Theme.Material3.Light.NoActionBar">

        <!-- Background -->
        <item name="android:windowBackground">#F4F7F2</item>
        <item name="android:colorBackground">#F4F7F2</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorSurfaceVariant">#EEF2EA</item>

        <!-- Main Sage Green -->
        <item name="colorPrimary">#7A9B76</item>
        <item name="colorPrimaryContainer">#DCE8D8</item>
        <item name="colorOnPrimary">#FFFFFF</item>

        <!-- Secondary -->
        <item name="colorSecondary">#9CAF88</item>
        <item name="colorSecondaryContainer">#E7EFE2</item>

        <!-- Accent -->
        <item name="colorTertiary">#B7C9A8</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">#F4F7F2</item>
        <item name="android:navigationBarColor">#FFFFFF</item>

        <!-- Disable force dark -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>

        <!-- Edge-to-edge -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement"
            tools:targetApi="vanilla_ice_cream">true</item>

    </style>

    <!-- ================= TEXT INPUT ================= -->
    <style name="Widget.App.TextInputLayout"
        parent="Widget.Material3.TextInputLayout.OutlinedBox">

        <!-- Box -->
        <item name="boxBackgroundColor">#FFFFFF</item>

        <!-- Border -->
        <item name="boxStrokeColor">#7A9B76</item>

        <!-- Hint -->
        <item name="hintTextColor">#7A9B76</item>

        <!-- Focus -->
        <item name="cursorColor">#7A9B76</item>

        <!-- Radius -->
        <item name="shapeAppearanceOverlay">
            @style/RoundedCornerStyle
        </item>

    </style>

    <!-- ================= ROUNDED CORNER ================= -->
    <style name="RoundedCornerStyle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

</resources>