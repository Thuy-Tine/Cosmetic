<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- BASE THEME -->
    <style name="Base.Theme.MyPham"
        parent="Theme.Material3.DayNight.NoActionBar">

        <!-- 🎨 COLORS -->
        <item name="colorPrimary">@color/sage_green</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="android:textColorPrimary">#2D3436</item>
        <item name="android:statusBarColor">#FBF7F4</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">#FBF7F4</item>

        <!-- 📝 DEFAULT FONT -->
        <item name="fontFamily">@font/inter</item>

    </style>

    <!-- 👑 HEADING STYLE -->
    <style name="CosmeticHeadlineStyle"
        parent="TextAppearance.Material3.TitleLarge">

        <item name="fontFamily">@font/montserrat</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#2D3436</item>

    </style>

    <!-- APP THEME -->
    <style name="Theme.MyPham"
        parent="Base.Theme.MyPham" />

</resources>